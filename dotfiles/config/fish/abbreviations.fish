# Abbreviations — edit live, no rebuild. Sourced from config.fish AFTER
# vendor plugins (e.g. git-abbr) so these custom values win on conflicts.
abbr --add --position anywhere '--set-cursor=%' -- L '% | less'
abbr --add -- fb 'forge build'
abbr --add -- fd 'forge script scripts/deploy/Deploy.s.sol:Deploy -vvv'
abbr --add -- fpl 'FOUNDRY_PROFILE=lite'
abbr --add -- fs 'forge snapshot'
abbr --add -- ft 'forge test'
abbr --add -- ftfs 'forge test --fail-fast --show-progress'
abbr --add -- ftmc 'forge test -vvvv --match-contract'
abbr --add -- ftmt 'forge test -vvvv --match-test'
abbr --add -- g 'git status'
abbr --add -- gbsu 'git branch --set-upstream-to=origin/$gcur $gcur'
abbr --add -- gcap 'git commit --all --amend --no-edit && git push --force-with-lease origin $gcur'
abbr --add -- gcs 'git show'
abbr --add -- gcss 'git show --stat'
abbr --add -- gcur 'git branch --show-current'
abbr --add -- gcuru 'git rev-parse --abbrev-ref @{upstream}'
abbr --add -- gdd 'git restore --worktree -- $(git rev-parse --show-toplevel) && git restore --staged -- $(git rev-parse --show-toplevel) && git clean -fd -- $(git rev-parse --show-toplevel)'
abbr --add -- gds 'git diff --staged'
abbr --add -- gdw 'git diff'
abbr --add -- gfdr 'git pull origin develop:develop && git rebase develop'
abbr --add -- gfm 'git pull'
abbr --add -- gfmoc 'git pull origin'
abbr --add -- gfmod 'git pull origin develop:develop'
abbr --add -- gfmom 'git fetch origin $gmain:$gmain'
abbr --add -- gfmr 'git fetch origin $gmain:$gmain && git rebase $gmain'
abbr --add -- gfo 'git fetch origin'
abbr --add -- gfodd 'git fetch origin develop:develop'
abbr --add -- ghu 'gh pr view --json url --jq .url | pbcopy'
abbr --add -- gifl 'git status -s | sed "$1q;d" | cut -c4-'
abbr --add -- gnuke 'git reset --hard HEAD && git clean -fd'
abbr --add -- gp 'git push origin $gcur'
abbr --add -- gpc 'git push --set-upstream origin $gcur'
abbr --add -- gpf 'git push --force-with-lease origin $gcur'
abbr --add -- gra 'git rebase --abort'
abbr --add -- grd 'git fetch && git rebase -i $gmbr'
abbr --add -- grmain 'git rebase $gmain'
abbr --add -- grr 'git fetch && gco $gmbl && git reset --hard $gmbr'
abbr --add -- grt 'git fetch && git reset --hard $(git rev-parse --abbrev-ref @{upstream})'
abbr --add -- histm 'history merge'
abbr --add -- hm 'home-manager switch --flake $HOME/Projects/Tools/nixfiles#$USER'
abbr --add -- jb 'just build-dev'
abbr --add -- jt 'just test-dev'
abbr --add -- lconf 'code ~/.config.fish'
abbr --add -- lfb 'FOUNDRY_PROFILE=lite forge build'
abbr --add -- lft 'FOUNDRY_PROFILE=lite forge test'
abbr --add -- lgb 'lg branch'
abbr --add -- lgd 'lg diff'
abbr --add -- lgl 'lg log'
abbr --add -- lgs 'lg status'
abbr --add -- nconf 'code ~/Projects/Tools/nixfiles'
abbr --add -- p 'echo $PATH | tr ":" "
"'
abbr --add -- qbc quick-branch-commit
abbr --add -- sfv 'set -x FOUNDRY_VERBOSITY'
abbr --add -- srf 'source ~/.config/fish/config.fish'
abbr --add -- vc viewci
abbr --add -- venv-activate 'source venv/bin/activate.fish'
abbr --add -- venv-new 'python3 -m venv venv'
